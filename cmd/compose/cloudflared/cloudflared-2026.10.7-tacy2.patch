diff --git a/ingress/tacy_test.go b/ingress/tacy_test.go
new file mode 100644
index 0000000..60dc9d2
--- /dev/null
+++ b/ingress/tacy_test.go
@@ -0,0 +1,49 @@
+package ingress
+
+import (
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+	"github.com/stretchr/testify/require"
+
+	"github.com/cloudflare/cloudflared/config"
+)
+
+// Tacy build: the WARP-routing dialer (TCP streams, UDP sessions of datagram v2 and v3, the virtual DNS service)
+// dials nothing, whatever its default dialer and reserved services are.
+func TestTacyOriginDialerRefuses(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer ln.Close()
+	accepted := make(chan struct{}, 1)
+	go func() {
+		if c, err := ln.Accept(); err == nil {
+			accepted <- struct{}{}
+			c.Close()
+		}
+	}()
+	udp, err := net.ListenPacket("udp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer udp.Close()
+	log := zerolog.Nop()
+	def := NewDialer(WarpRoutingConfig{ConnectTimeout: config.CustomDuration{Duration: time.Second}})
+	d := NewOriginDialer(OriginConfig{DefaultDialer: def}, &log)
+	tcpAddr := netip.MustParseAddrPort(ln.Addr().String())
+	udpAddr := netip.MustParseAddrPort(udp.LocalAddr().String())
+	d.AddReservedService(def, []netip.AddrPort{udpAddr})
+
+	c, err := d.DialTCP(t.Context(), tcpAddr)
+	require.ErrorIs(t, err, ErrPrivateRoutingRefused)
+	require.Nil(t, c)
+	u, err := d.DialUDP(udpAddr)
+	require.ErrorIs(t, err, ErrPrivateRoutingRefused)
+	require.Nil(t, u)
+	select {
+	case <-accepted:
+		t.Fatal("DialTCP reached the loopback target")
+	case <-time.After(300 * time.Millisecond):
+	}
+}
