+package orchestration
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/cloudflare/cloudflared/ingress"
+)
+
+// Tacy build: a config the edge pushes is refused whatever its version; the local config keeps serving.
+func TestTacyRefusesRemoteConfig(t *testing.T) {
+	originDialer := ingress.NewOriginDialer(ingress.OriginConfig{DefaultDialer: testDefaultDialer, TCPWriteTimeout: time.Second}, &testLogger)
+	o, err := NewOrchestrator(t.Context(), &Config{Ingress: &ingress.Ingress{}, OriginDialerService: originDialer}, testTags, nil, &testLogger)
+	require.NoError(t, err)
+	before, err := o.GetOriginProxy()
+	require.NoError(t, err)
+	pushed := []byte(`{"ingress":[{"service":"http://127.0.0.1:8080"}],"warp-routing":{"enabled":true}}`)
+	for _, v := range []int32{1, 2, 1 << 30} {
+		resp := o.UpdateConfig(v, pushed)
+		require.Nil(t, resp.Err)
+		require.Equal(t, int32(-1), resp.LastAppliedVersion)
+	}
+	after, err := o.GetOriginProxy()
+	require.NoError(t, err)
+	require.Same(t, before, after)
+}
